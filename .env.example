# Copy to .env.local and fill in. Never commit real values.
# These are the CredIssuer issuance settings. To use another issuance engine,
# see docs/issuer-integration.md.

# CredIssuer API token for the issuing organisation. No VITE_ prefix on purpose:
# only the dev server proxy reads it, so it never ends up in the browser bundle.
# In production, nginx reads it from the container's environment instead.
ISSUER_API_TOKEN=

# The VITE_* values below are inlined into the browser bundle at build time.
# Digital ID credential template ID
VITE_ISSUER_TEMPLATE_ID=
# Issuing organisation code
VITE_ISSUER_ORG_CODE=
# Email address of the issuer account
VITE_ISSUER_EMAIL=
