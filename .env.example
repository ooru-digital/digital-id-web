# Copy to .env.local and fill in. Never commit real values.
# All VITE_* values are inlined into the browser bundle at build time.
# These are the CredIssuer issuance settings. To use another issuance engine,
# see docs/issuer-integration.md.

# CredIssuer API token for the issuing organisation (sent as a Bearer token)
VITE_ISSUER_API_TOKEN=
# Digital ID credential template ID
VITE_ISSUER_TEMPLATE_ID=
# Issuing organisation code
VITE_ISSUER_ORG_CODE=
# Email address of the issuer account
VITE_ISSUER_EMAIL=
